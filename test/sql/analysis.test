# name: test/sql/analysis.test
# group: [vgi_color]
#
# Color analysis: delta_e (CIEDE2000), luminance, contrast_ratio, wcag_level,
# is_dark, nearest_color_name, and the named_colors() table function. Floats are
# asserted with ROUND() for determinism. Invalid hex flows to NULL.

require-env VGI_COLOR_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'color' AS color (TYPE vgi, LOCATION '{VGI_COLOR_WORKER}');

statement ok
SET search_path = 'color.main';

# Contrast of black vs white is exactly 21.
query R
SELECT ROUND(contrast_ratio('#000000', '#ffffff'), 1);
----
21.0

# Contrast of a color with itself is 1.
query R
SELECT ROUND(contrast_ratio('#ffffff', '#ffffff'), 1);
----
1.0

# WCAG level for black text on white is AAA.
query T
SELECT wcag_level('#000000', '#ffffff');
----
AAA

# Luminance extremes.
query R
SELECT ROUND(luminance('#000000'), 4);
----
0.0

query R
SELECT ROUND(luminance('#ffffff'), 4);
----
1.0

# delta_e of a color with itself is 0.
query R
SELECT ROUND(delta_e('#ff0000', '#ff0000'), 2);
----
0.0

# delta_e of a known nonzero pair (white vs black) is large and stable.
query R
SELECT ROUND(delta_e('#ffffff', '#000000'), 2);
----
100.0

# is_dark: black is dark, white is not.
query T
SELECT is_dark('#000000');
----
true

query T
SELECT is_dark('#ffffff');
----
false

# is_dark uses the WCAG crossover (luminance < ~0.1791), not 0.5: mid-grey takes
# black text (5.32:1 vs white 3.95:1), so it is not dark; navy is.
query TT
SELECT is_dark('#808080'), is_dark('#001f3f');
----
false	true

# is_dark always picks the higher-contrast of white/black text, for every named color.
query I
SELECT COUNT(*) FROM named_colors WHERE is_dark(hex) <> (contrast_ratio('#ffffff', hex) > contrast_ratio('#000000', hex));
----
0

# nearest_color_name maps pure red to 'red'.
query T
SELECT nearest_color_name('#ff0000');
----
red

# named_colors() returns a populated table.
query I
SELECT COUNT(*) > 0 FROM named_colors();
----
true

# The full CSS Color 4 keyword set: 148 names, including the seven grey aliases.
query II
SELECT COUNT(*), COUNT(*) FILTER (WHERE name LIKE '%grey') FROM named_colors;
----
148	7

query T
SELECT hex FROM named_colors WHERE name = 'slategrey';
----
#708090

# nearest_color_name keeps returning the 'gray' spelling for an exact grey.
query T
SELECT nearest_color_name('#808080');
----
gray

# 'red' appears in the table at #ff0000.
query T
SELECT hex FROM named_colors() WHERE name = 'red';
----
#ff0000

# Invalid hex → NULL (not an error).
query R
SELECT contrast_ratio('bogus', '#ffffff');
----
NULL

query T
SELECT nearest_color_name('bogus');
----
NULL

# NULL input → NULL.
query R
SELECT luminance(NULL);
----
NULL

statement ok
USE memory;

statement ok
DETACH color;
